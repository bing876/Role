{
  "name": "workbench-ui",
  "version": "0.1.0",
  "private": true,
  "description": "AI 工作台前端 —— 复刻设计基准 workbench.work.html（React + Vite + TS 独立项目）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:single": "tsc -p tsconfig.json --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "resplit": "python tools/split.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
