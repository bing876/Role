# ============================================================
# AI 工作台后端环境变量样例。复制为 apps/server/.env 后填写。
# .env 已被 .gitignore 挡住——**永远不要提交真实密钥**。
# 敏感密钥只认环境变量：代码里没有兜底，缺了就拒启/拒发（这是特性）。
# ============================================================

# 服务监听端口（桌面端默认连 http://127.0.0.1:8787）
PORT=8787

# PostgreSQL 连接串，默认对应 apps/server/docker-compose.yml
DATABASE_URL=postgresql://workbench:workbench@localhost:5432/workbench

# JWT 签名密钥：≥16 位高熵字符串。生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 敏感字段 AES-256-GCM 密钥（phone_enc / messages.content 等）。
# 建议直接放上面生成器输出的 64 位十六进制。
DATA_KEY=

# 手机号哈希用的 pepper（一手机一用户唯一索引的盐）。**必填**，缺失拒绝启动。
# ★ 必须是**独立于 DATA_KEY** 的值（复用同一把钥匙 = 一处泄漏连带另一处）。
#   生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 改动这个值会让**已有用户登录不上**（库里的 phone_hash 是用旧 pepper 算的）。
#    迁移：解密 users.phone_enc → 用新 pepper 重算 phone_hash → 回写。
#    参考脚本：scripts/verify/p12-pepper-migrate.py
PHONE_PEPPER=

# 短信模式：
#   开发：SMS_MOCK=1 —— 验证码只写进**服务器日志**，响应里绝不返回验证码
#   生产：SMS_MOCK 不设，且必须配 SMS_HTTP_URL，否则 /auth/sms/send 直接拒绝并说人话
SMS_MOCK=1

# 通用短信通道（POST JSON {phone, code} 到你的网关；接厂商的适配层自己包一层）。生产必填。
SMS_HTTP_URL=

# 运行环境标记（production 时强制检查短信通道配置）
NODE_ENV=development

# ---- 第 6 步：DeepSeek 流式聊天 ----
# API Key **只填在这里**（apps/server/.env）。它绝不出现在前端 / preload / git；
# 不填也不会崩：/chat/stream 会明确回 503 llm_not_configured，桌面提示「未配置模型」。
DEEPSEEK_API_KEY=

# 可选：OpenAI 兼容网关地址（换官方镜像/代理才动）。默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名。默认 deepseek-chat（官方对话模型）；写死在服务端配置，前端不感知
DEEPSEEK_MODEL=deepseek-chat

# ---- 第 8 步：通知通道（本步只有空位，不接真推送）----
# 设成 1 可让通知桩函数“故意失败”，用来验证：通知挂了任务仍是 done、红点文档不受影响
NOTIFY_STUB_FAIL=

# ---- 第 21 步：网页工具循环（脑在服务端；手在桌面那张可见的 webview 上）----
# 一轮最多走几步。
# ★ 2026-09-20 用户拍板：默认**不再按步数掐断任务**，一路做到 done 为止 —— 以前一轮
#   只走 10 步就停下来问「要我接着做就点『继续』」，复杂环节被切成好几段，很烦。
#
#   留空 / 0 / 负数 = **不限步数**（推荐，默认值）
#                —— 只受代码里的硬兜底（200 步）约束，那是防「read_page→read_page」
#                   这类成功死循环烧 token 的最后一道闸，正常任务碰不到。
#   配成正数（8~200）= 回到旧行为：一轮走满 N 步就停下来问，说「继续」或点「继续」按钮都能接回。
AGENT_LOOP_MAX_STEPS=

# ---- 第 26 步：联网搜索（Tavily）----
# ★ 这是**轻量查资料**能力：一次 HTTPS 请求拿回结果，**不启动任何浏览器实例**、
#   不占用浏览器相关资源、不触发全屏浏览器、不出现后台小图标。
#   它和「浏览器操作」（用户主动点开、AI 真操作网页）是两套互不干扰的系统。
# ★ 该能力**与模型解耦**：任何模型都能调，不属于 DeepSeek 专属逻辑。
# key **只填在这里**（apps/server/.env）；绝不出现在前端 / preload / 日志 / git。
# 不填也不会崩：调用方会拿到「未配置」的明确错误并拒绝外呼。
TAVILY_API_KEY=

# 可选：Tavily 接口地址（换官方代理/镜像才动）。默认 https://api.tavily.com
TAVILY_BASE_URL=https://api.tavily.com

# ============================================================
# 多智能体编排（2026-09-23）
#
# ★ **这一整段都可以不写** —— 每一项都有默认值（见下），一个不填就是默认行为。
#   唯一会影响「能不能用起来」的是 DEEPSEEK_API_KEY（上面那一段）：
#   没有它，临时工与被委派方都问不到模型，编排自然跑不起来。
#   想让临时工/被委派方能查资料，再配 TAVILY_API_KEY（不配则搜索返回「未配置」，不崩）。
# ============================================================

# 编排总开关。设 0 = 三个编排工具都不注册，主循环工具表回到改动前那张
# （LOOP_SYSTEM_PROMPT 一个字没改过，所以关掉就是**完全旧行为**）。默认开。
ORCHESTRATION_TOOLS=1

# 主浏览器循环要不要顺手能查公开资料。默认开。
# （临时工 / 被委派方本来就能搜，这一项只管「用户直接对话的那一路」）
AGENT_LOOP_WEB_SEARCH=1

# ---- 委派（智能体之间交活）----
# ★ 超时熔断线：到点如实回「暂未完成」，绝不挂死。默认 600000 = **10 分钟**。
#   配歪了也不会出事：会被夹到 60000 ~ 1800000（1~30 分钟）之间。
DELEGATE_TIMEOUT_MS=600000
# 同一个智能体同时最多接几件委派。默认 1（v1 不排队，忙就当场拒）。
DELEGATE_MAX_ACTIVE_PER_AGENT=1
# 委派最多转几层（防踢皮球）。默认 2。
DELEGATE_MAX_DEPTH=2
# 一条循环最多委派几次。默认 3。
DELEGATE_MAX_PER_LOOP=3

# ---- 临时工（并行子任务）----
# 同时跑几个。默认 3。
WORKER_CONCURRENCY=3
# 一次最多派几个。默认 5。
WORKER_MAX_PER_CALL=5
# 一条循环累计最多派几个。默认 12。
WORKER_MAX_PER_LOOP=12
# 单个临时工超时 / 整批预算（毫秒）。默认 120000 / 180000。
WORKER_TIMEOUT_MS=120000
WORKER_JOB_BUDGET_MS=180000
# 单个临时工最多搜几轮。默认 2（0 = 不许搜，只靠推理）。
WORKER_MAX_SEARCH_ROUNDS=2

# ---- 后台子任务总量闸 ----
# 全局最多几个在飞的后台子任务（临时工批次 + 委派）。默认 8。
ORCH_MAX_LIVE_JOBS=8
# 同时最多几条被委派的子循环。默认 8。
SUB_LOOP_MAX_LIVE=8
# 一条循环最多真搜几轮。默认 3。
WEB_SEARCH_MAX_ROUNDS_PER_LOOP=3

